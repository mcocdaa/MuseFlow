# MuseFlow Frontend Environment Configuration
# Copy to .env.local for standalone frontend deployment

# Backend origin used by Vite dev server proxy (/api -> VITE_BACKEND_ORIGIN)
VITE_BACKEND_ORIGIN=http://127.0.0.1:8765

# Explicit API base URL when hosting frontend separately from backend (default: /api)
# Example: http://127.0.0.1:8765/api
VITE_API_BASE_URL=/api
