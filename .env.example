# MuseFlow (灵眸流) Environment Variables Configuration Template
# Copy this file to .env and modify as needed.

# ==========================================
# Network & Server Settings
# ==========================================
MUSEFLOW_HOST=0.0.0.0
MUSEFLOW_PORT=8765

# Data directory for database and thumbnails (defaults to backend/data if not specified)
# In Docker, this is mounted to /data
MUSEFLOW_DATA_DIR=

# Maximum telemetry dwell time per playback in seconds (prevents overnight window inflation)
MAX_DWELL_SECONDS=180.0

# ==========================================
# AI LLM Directory Topology Triage Settings
# ==========================================
# OpenAI-compatible API Endpoint (supports Grok, Claude, DeepSeek, GPT-4o, Ollama)
LLM_BASE_URL=https://pool.creative-koala-llm.top/v1
LLM_API_KEY=sk-ad3e4bdafe5c4c832cefe1562eb82dce20c2d103b54716cf266c7a4a0cf1fa5f
LLM_MODEL=grok-4.7

# Optional HTTP/HTTPS proxy for LLM requests (e.g., http://127.0.0.1:7897)
# HTTP_PROXY=
# HTTPS_PROXY=
